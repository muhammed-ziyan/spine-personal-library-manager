# Copy this file to `.env` if you want it. `.env` is git-ignored.
#
# Spine has no sign-in and no build-time backend setting: you connect a library
# from inside the app (the Connect screen, later You → Libraries) by pasting
# the "Web app" URL of your Apps Script deployment. Connections are stored in
# the browser on that device only.
#
# The one optional value below just pre-fills the Connect screen — handy in
# development with `npm run dev:backend`. It is never a secret.
# Looks like: https://script.google.com/macros/s/AKfyc.../exec
VITE_APPS_SCRIPT_URL=
