# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
#
# Neither value below is a secret in the traditional sense — both are shipped to
# the browser — but keep them out of Git anyway so the repository stays
# environment-agnostic and so you can rotate deployments freely.

# The "Web app" URL of your Apps Script deployment.
# Looks like: https://script.google.com/macros/s/AKfyc.../exec
VITE_APPS_SCRIPT_URL=

# OAuth 2.0 *Web* client ID from Google Cloud Console (Credentials page).
# Client IDs are public identifiers, but the matching *client secret* must never
# be used anywhere in this project — Spine never needs it.
# Looks like: 1234567890-abc123.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
