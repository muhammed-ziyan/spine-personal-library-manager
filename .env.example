# Copy this file to `.env` for local development. `.env` is git-ignored.
#
# ─── Required, in every environment ───────────────────────────────────────────
#
# The Apps Script deployment Spine talks to. In production (Vercel: Project →
# Settings → Environment Variables, then redeploy) this is the "Web app" URL of
# your deployment, ending in /exec:
#
#   VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfyc.../exec
#
# Locally, `/api` is proxied by the Vite dev server to `npm run dev:backend`.
# This value is baked into the built bundle and is not a secret: it grants
# nothing without a signed-in session.
VITE_APPS_SCRIPT_URL=/api

# ─── Local development only ───────────────────────────────────────────────────
#
# The username and password `npm run dev:backend` will accept, standing in for
# the AUTH_USERNAME and AUTH_PASSWORD Script Properties of a real deployment.
#
# Note the missing VITE_ prefix: that is deliberate and load-bearing. Only
# VITE_-prefixed variables reach the browser, and a password must never be one
# of them. The real password lives in Script Properties and is only ever
# compared inside your Apps Script.
SPINE_AUTH_USERNAME=you@example.com
#
# Quote the password if it contains '#', spaces, or quotes: Node reads an
# unquoted '#' as the start of a comment and would silently truncate it.
SPINE_AUTH_PASSWORD='choose-a-long-one'

# Optional: where the dev backend listens, if not http://localhost:8787.
# DEV_BACKEND_URL=http://localhost:8787
