# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
dev-dist/
*.local

# Environment / secrets — never commit real configuration
.env
.env.*
!.env.example

# Apps Script local deployment state (clasp)
apps-script/.clasp.json
apps-script/.clasprc.json
.clasprc.json

# Deployment state (vercel link, pulled env)
.vercel/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.history/
*.swp
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches and incremental build state
*.tsbuildinfo
.eslintcache
.vite/
.cache/

# Test output — coverage reports and browser-driven runs
coverage/
test-results/
playwright-report/
playwright/.cache/

# Self-signed dev certificates (`npm run dev` serves https on the LAN)
*.pem
*.key
*.crt

# Scratch files
tmp/
*.tmp
